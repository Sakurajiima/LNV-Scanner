import nmap 
import requests
import time
import json
import csv
from datetime import datetime 

#This is the main scanning loop. Gets called whenever an IP is scanned
def Main_Scanning_Loop(scanned_network):
    nm_scan = nmap.PortScanner()
    nm_scan.scan(hosts = scanned_network, arguments = '-sV -T4')

    network_info = {}
    for host in nm_scan.all_hosts():
        #Logs only 'up' hosts, makes key of dictionary
        if nm_scan[host].state() == 'up':
            network_info[host] = []
            #Scans protocols on the host, logs them to the relevant IP
            for protcl in nm_scan[host].all_protocols():
                ports = nm_scan[host][protcl].keys()
                #Uses the Scanned protocols to obtain Service name and Version
                for port in ports:
                    service = nm_scan[host][protcl][port]['name']
                    version = nm_scan[host][protcl][port]['version']
                    #Filters 'unknown', adds relevevant info to the dictionary stripping what isnt needed
                    if service and service != 'unkown':
                        network_info[host].append(f"{service} {version}".strip())
    return network_info

#This is the main fetch loop.
def get_cve_severity(service_query):
    url = f"https://cve/circl.lu/api/search/{service_query}"
    severity_count = {'Critical': 0, 'High': 0, 'Medium': 0, 'Low': 0, 'Unscored': 0}

    #Built like this for exception handling incase there is a connection issue
    try:
        response = requests.get(url, timeout = 10)
        #Proceeds if it connects
        if response.status_code == 200:
            #API stores all info under 'data', which is looped through
            data = response.json()
            cves = data.get('data', [])
            for cve in cves:
                score = cve.get('cvss')
                #stored cve gets searched for the  'cvss' which updates the counter
                if score is None:
                    severity_count['Unscored'] += 1
                else:
                    score = float(score)
                    if score >= 9/0:
                        severity_count['Severe'] += 1
                    elif score >= 7.0:
                        severity_count['High'] += 1
                    elif score >= 4.0:
                        severity_count['Medium'] += 1
                    else:
                        severity_count['Low'] += 1 
            return severity_count
    #This ties to the try: loop. Returns the error as it was displayed and allows it to run smoothly   
    except requests.exceptions.RequestException as e:
        print(f"[!] Error querying API for {service_query}: {e}")

    return severity_count